{
  "name": "devhub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-gatherhub.mjs && node scripts/build-blog.mjs",
    "build": "vite build && vite build --config vite.ssr.config.ts && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "postbuild": "node scripts/generate-sitemap.mjs && node scripts/generate-llms.mjs && node scripts/check-seo.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.10",
    "marked-highlight": "^2.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  }
}
