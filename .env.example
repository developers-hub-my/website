# GatherHub signed public API — used only by scripts/fetch-gatherhub.mjs at
# BUILD time. Never referenced from client code; secrets never reach the bundle.
# Required only when a class in src/data/classes.json has a gatherhub_event_uuid.
GATHERHUB_BASE_URL=https://my.gatherhub.app
GATHERHUB_CLIENT_KEY=
GATHERHUB_CLIENT_SECRET=
GATHERHUB_CLIENT_DOMAIN=devhub.my

# g8crm Lead Intake endpoint — the "Get Notified" modal on /trainings landing
# pages POSTs name/email/phone/company here directly (no auth; the unguessable
# token in the path is the credential, so the URL is public by design and is
# baked into the client bundle like any web form action — exposed VITE_-free
# via envPrefix in vite.config.ts). Create endpoints (type API) at
# CRM › Settings › Intake Channels. When unset, the "Get Notified" button and
# modal are not rendered at all.
CRM_INTAKE_CHANNEL_API=https://crm.devhub.my/api/intake/<token>

# DevHub's public GatherHub organization page — "See Available Sessions" CTA
# on /trainings landing pages. Public URL (not a secret), standard VITE_
# prefix. The CTA is currently hidden behind SHOW_GATHERHUB_SESSIONS in
# src/lib/gatherhub.ts, so this only takes effect once that flag is flipped.
VITE_GATHERHUB_ORG_URL=https://my.gatherhub.app/<org-slug>

# "Company Profile" document — the external URL behind the Navbar/Footer link
# and the /company-profile route (the path encoded in the printed QR code).
# When unset, the nav/footer link is hidden and /company-profile falls back to
# the homepage. Standard VITE_ prefix, so it reaches client code as-is.
VITE_COMPANY_PROFILE_URL=https://devhub.my/company-profile.pdf

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Public identifier, not a
# secret — baked into the bundle at build time via the standard VITE_ prefix.
# Analytics is disabled entirely when unset, so local dev builds stay untracked.
VITE_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID. Public identifier, not a secret — baked into the
# bundle at build time via the standard VITE_ prefix (set in the Netlify build
# environment). The pixel is disabled entirely when unset, so local dev builds
# stay untracked.
VITE_META_PIXEL_ID=
